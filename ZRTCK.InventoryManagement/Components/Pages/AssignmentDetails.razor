@page "/assignments/{AssignmentId:int}"
@using Microsoft.EntityFrameworkCore
@using ZRTCK.InventoryManagement.Persistence
@inject IDbContextFactory<InventoryDbContext> DbFactory
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Наказ на закріплення майна</PageTitle>
<MudBreadcrumbs Items="_breadcrumbItems"/>

<MudPaper Class="pa-4 mt-2">
    @if (_assignment == null)
    {
        <MudProgressCircular Indeterminate="true"/>
    }
    else
    {
        <div class="d-flex align-center mb-4">
            <MudText Typo="Typo.h4">
                Деталі наказу
                @if (_assignment.OrderId.HasValue)
                {
                    @($" №{_assignment.OrderId}")
                }
                @if (_assignment.OrderDate.HasValue)
                {
                    @($" від {_assignment.OrderDate.Value:d}")
                }
            </MudText>
        </div>

        <MudTable Items="@_groupedRows" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true"
                  GroupBy="@_groupDefinition">
            <HeaderContent>
                <MudTh>Найменування майна</MudTh>
                <MudTh>Інвентарні номери</MudTh>
                <MudTh>Дії</MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="mud-theme-primary" colspan="3">
                    @context.Items.First().RecipientTitle
                </MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="Найменування майна">@context.ProductDisplay</MudTd>
                <MudTd DataLabel="Інвентарні номери">@string.Join(", ", context.InventoryNumbers)</MudTd>
                <MudTd DataLabel="Дії">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary"
                                   OnClick="@(() => CopyForReportAsync(context.ReportLine))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter] public int AssignmentId { get; set; }

    private InventoryAssignment? _assignment;
    private readonly List<BreadcrumbItem> _breadcrumbItems =    [
        new("Головна", href: "/", icon: Icons.Material.Filled.Home),
        new("Накази", href: "/assignments"),
        new("Деталі наказу", href: null, disabled: true)
    ];

    private readonly TableGroupDefinition<AssignmentItemGroup> _groupDefinition = new()
    {
        GroupName = "Особа",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = true,
        Selector = (e) => e.PersonId
    };

    private List<AssignmentItemGroup> _groupedRows = new();
    private AssignmentDetailsClipboardInterop? _clipboard;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _assignment = await context.Assignments
            .Include(a => a.AssignmentRows)
            .ThenInclude(r => r.Person)
            .Include(a => a.AssignmentRows)
            .ThenInclude(r => r.InventoryItem)
            .FirstOrDefaultAsync(a => a.Id == AssignmentId);

        if (_assignment != null)
        {
            _groupedRows = _assignment.AssignmentRows
                .GroupBy(row => new { row.PersonId, row.Person })
                .SelectMany(personGroup => personGroup
                    .GroupBy(row => new { row.InventoryItem.ProductCode, row.InventoryItem.Name })
                    .Select(itemGroup => new AssignmentItemGroup(
                        personGroup.Key.PersonId,
                        GetRecipientTitle(personGroup.Key.Person),
                        itemGroup.Key.ProductCode,
                        itemGroup.Key.Name,
                        itemGroup.Select(row => row.InventoryItemId)
                            .OrderBy(id => id, StringComparer.Ordinal)
                            .ToList())))
                .OrderBy(row => row.RecipientTitle, StringComparer.CurrentCulture)
                .ThenBy(row => row.Name, StringComparer.CurrentCulture)
                .ThenBy(row => row.ProductCode, StringComparer.CurrentCulture)
                .ToList();
        }
    }

    private static string GetRecipientTitle(Person person) => person.IsPosition
        ? $"Посада: {person.Position} ({person.Rank} {person.FirstName} {person.LastName.ToUpperInvariant()})"
        : $"Особа: {person.Rank} {person.FirstName} {person.LastName} ({person.Position})";

    private async Task CopyForReportAsync(string text)
    {
        _clipboard ??= new AssignmentDetailsClipboardInterop(JS);
        await _clipboard.CopyAsync(text);
    }

    public async ValueTask DisposeAsync()
    {
        if (_clipboard != null)
            await _clipboard.DisposeAsync();
    }

    private sealed record AssignmentItemGroup(
        int PersonId,
        string RecipientTitle,
        string ProductCode,
        string Name,
        IReadOnlyList<string> InventoryNumbers)
    {
        public string ProductDisplay => string.IsNullOrWhiteSpace(ProductCode) ? Name : $"{Name} ({ProductCode})";

        public string ReportLine => $"{ProductDisplay} інв. {(InventoryNumbers.Count == 1 ? "№" : "№№")} {string.Join(", ", InventoryNumbers)}";
    }

}
